# Metabase
METABASE_URL=https://metabase.kaip.in
METABASE_API_KEY=

# Metabase question (card) IDs. Leave a source blank and its sections show "not connected".
MB_Q_PRODUCTS=16450
MB_Q_ADS=
MB_Q_CATALOG=

# Postgres (Railway sets this automatically when you add the Postgres plugin).
# Without it the app keeps task ticks and the decision log in memory (lost on restart).
DATABASE_URL=

# Minutes to cache Metabase results before re-querying.
CACHE_TTL_MIN=30

# Optional: set to require a password (HTTP basic auth, any username). Empty = open.
DASHBOARD_PASSWORD=

# Local development only: read products.csv / ads.csv / catalog.csv from this folder instead of Metabase.
DATA_DIR=

PORT=3000
