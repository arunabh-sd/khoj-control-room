# Metabase
METABASE_URL=https://metabase.kaip.in
METABASE_API_KEY=

# Metabase question (card) IDs. Leave a source blank and its sections show "not connected".
MB_Q_DAYWISE=16083
MB_Q_PNL=16167
MB_Q_PRODUCTS=16450
MB_Q_ADS=16659
MB_Q_PRODUCT_SPEND=16674
MB_Q_ADSET_MAP=16676
# ShopDeck universe: all products with PQ >= 3 (one row per product, or counts by category)
MB_Q_UNIVERSE=16457
MB_Q_UNIVERSE_PARAMS=min_pq=3
MB_Q_OVERLAP=16494
MB_Q_CUSTOMER_HISTORY=16717
MB_Q_EVENTS=16724
MB_Q_BENCHMARK=16725
MB_Q_PRODUCT_QUALITY=
MB_Q_KHOJ_ORDERS=
MB_Q_REVISIT=
# MB_Q_RATING=16826  MB_Q_RETURNS=16859  MB_Q_BUMPER=16830 (defaults)

# Storage: on Netlify, Netlify Blobs is used automatically (nothing to set).
# On another Node host, set a Postgres URL; without one, ticks and the decision log live in memory.
DATABASE_URL=

# Optional: set to require a password (HTTP basic auth, any username). Empty = open. Ignored once Google sign-in is on.
DASHBOARD_PASSWORD=

# Sign in with Google + usage tracking. GOOGLE_CLIENT_ID turns it on.
GOOGLE_CLIENT_ID=
ALLOWED_DOMAINS=shopdeck.com,blitzscale.co
ADMIN_EMAILS=arunabh.mishra@blitzscale.co,piyush.sinhal@blitzscale.co
# Optional: defaults to a key derived from METABASE_API_KEY.
SESSION_SECRET=

# Local development only: read products.csv / ads.csv / catalog.csv from this folder instead of Metabase.
DATA_DIR=

PORT=3000
